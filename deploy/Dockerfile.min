# Minimal runtime image: only the main package deps (ray/numpy/cv2/matplotlib/...).
# Model envs and weights are mounted via hostPath (/ego), avoiding a 10GB image push.
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04
# An HTTP proxy is required for apt/pip at build time (the container does not inherit the host environment).
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV DEBIAN_FRONTEND=noninteractive OPENBLAS_NUM_THREADS=1 PYTHONDONTWRITEBYTECODE=1 \
    http_proxy=${HTTP_PROXY} https_proxy=${HTTPS_PROXY} no_proxy=${NO_PROXY}
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python3-pip libgl1 libglib2.0-0 ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/ego/app
COPY pyproject.toml README.md ./
COPY src ./src
COPY scripts ./scripts
COPY configs ./configs
RUN python3 -m pip install --no-cache-dir --upgrade pip \
 && python3 -m pip install --no-cache-dir "ray[default]==2.59.0" "numpy<2" \
      opencv-python-headless matplotlib jinja2 "openai>=1.40" pyyaml pytest pytest-timeout \
 && python3 -m pip install --no-cache-dir -e .
ENV PYTHONPATH=/opt/ego/app/src
CMD ["python3","-c","import roboray;print('roboray',roboray.__version__)"]
